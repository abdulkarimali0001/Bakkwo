<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Bakkwo.UI.Controls"
             x:Class="Bakkwo.Mobile.MainView">

  <UserControl.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#6C5CE7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,16" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#5A4BD6" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#4A3CC0" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <DockPanel x:Name="Page" Margin="18,14,18,10">

      <!-- Header -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto">
        <Image Grid.Column="0" Source="/Assets/icon-256.png" Width="46" Height="46" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="바꿔" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom" />
          <TextBlock Text="Bakkwo" FontSize="17" FontWeight="SemiBold" Opacity="0.55" VerticalAlignment="Bottom" Margin="0,0,0,3" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="LanguageButton" Classes="small" />
          <Button x:Name="AboutButton" Classes="small" Content="ⓘ" />
        </StackPanel>
      </Grid>

      <TextBlock x:Name="SubtitleText" DockPanel.Dock="Top" Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap" />

      <!-- Pick files -->
      <Border DockPanel.Dock="Top" Margin="0,14,0,0" Padding="16" CornerRadius="22" Background="#146C5CE7"
              BorderBrush="#556C5CE7" BorderThickness="1.5">
        <StackPanel Spacing="10">
          <Button x:Name="PickButton" Classes="primary" />
          <TextBlock x:Name="PickHint" Opacity="0.7" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Options -->
      <Expander x:Name="OptionsExpander" DockPanel.Dock="Top" Margin="0,12,0,0" HorizontalAlignment="Stretch">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock x:Name="QualityCaption" VerticalAlignment="Center" />
            <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="10" Maximum="100" Value="90" Margin="12,0"
                    TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            <TextBlock x:Name="QualityLabel" Grid.Column="2" Text="90" Width="30" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock x:Name="MaxSizeCaption" VerticalAlignment="Center" />
            <ComboBox x:Name="MaxSizeBox" Grid.Column="1" Margin="12,0,0,0" SelectedIndex="0" HorizontalAlignment="Stretch">
              <ComboBoxItem x:Name="OriginalItem" />
              <ComboBoxItem Content="3840 px · 4K" />
              <ComboBoxItem Content="1920 px · 1080p" />
              <ComboBoxItem Content="1280 px · 720p" />
              <ComboBoxItem Content="1080 px" />
              <ComboBoxItem Content="512 px" />
            </ComboBox>
          </Grid>
          <CheckBox x:Name="GrayscaleBox" />
        </StackPanel>
      </Expander>

      <!-- Footer -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="3">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="13" />
        <TextBlock x:Name="LimitsText" Opacity="0.55" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Results -->
      <DockPanel Margin="0,14,0,0">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBlock x:Name="RecentCaption" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="ClearButton" Grid.Column="1" Classes="small" Padding="12,4" MinHeight="32" />
        </Grid>
        <Panel>
          <TextBlock x:Name="EmptyText" Opacity="0.5" HorizontalAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap" />
          <ScrollViewer>
            <ItemsControl x:Name="ResultsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="14" Background="#128A8F98">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxLines="4" />
                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding IsRunning}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDone}">
                        <Button Classes="small" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" />
                        <Button Classes="small" Content="{Binding ShareLabel}" Command="{Binding ShareCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </DockPanel>

    <!-- The ring, over a dimmed screen. Touch a slice, or slide around the ring and let go on one. -->
    <Grid x:Name="RingLayer" IsVisible="False" Background="#B0101018">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Margin="16">
        <controls:DonutMenu x:Name="Donut" HorizontalAlignment="Center" />
        <TextBlock x:Name="RingHint" Foreground="White" Opacity="0.9" TextWrapping="Wrap" MaxWidth="320"
                   TextAlignment="Center" HorizontalAlignment="Center" />
        <Button x:Name="RingCancel" Classes="small" HorizontalAlignment="Center" MinWidth="120"
                HorizontalContentAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- About -->
    <Grid x:Name="AboutLayer" IsVisible="False" Background="#B0101018">
      <Border Margin="24" Padding="24" CornerRadius="22" VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Image Source="/Assets/icon-256.png" Width="96" Height="96" />
          <TextBlock Text="바꿔 Bakkwo" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
          <TextBlock x:Name="AboutTagline" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock x:Name="AboutMeaning" Opacity="0.7" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock x:Name="AboutVersion" Opacity="0.7" HorizontalAlignment="Center" />
          <TextBlock x:Name="AboutMadeBy" Opacity="0.7" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock x:Name="AboutInspired" Opacity="0.5" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
          <Button x:Name="AboutClose" Classes="small" HorizontalAlignment="Center" Margin="0,8,0,0" MinWidth="120"
                  HorizontalContentAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
