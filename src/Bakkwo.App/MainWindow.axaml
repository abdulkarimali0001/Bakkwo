<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Bakkwo.UI.Controls"
        x:Class="Bakkwo.App.MainWindow"
        Title="바꿔 Bakkwo"
        Icon="/Assets/icon-256.png"
        Width="900" Height="660"
        MinWidth="660" MinHeight="520">

  <Grid x:Name="Root" DragDrop.AllowDrop="True">
    <DockPanel Margin="28,20,28,18">

      <!-- Header: icon, Korean + Latin name, language switch and About -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto">
        <Image Grid.Column="0" Source="/Assets/icon-256.png" Width="56" Height="56" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="1">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="바꿔" FontSize="30" FontWeight="Bold" VerticalAlignment="Bottom" />
            <TextBlock Text="Bakkwo" FontSize="20" FontWeight="SemiBold" Opacity="0.55" VerticalAlignment="Bottom" Margin="0,0,0,3" />
          </StackPanel>
          <TextBlock x:Name="SubtitleText" Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button x:Name="LanguageButton" MinWidth="76" HorizontalContentAlignment="Center" />
          <Button x:Name="AboutButton" Content="ⓘ" Width="36" HorizontalContentAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Options -->
      <WrapPanel DockPanel.Dock="Top" Margin="0,18,0,0" Orientation="Horizontal">
        <TextBlock x:Name="QualityCaption" VerticalAlignment="Center" />
        <Slider x:Name="QualitySlider" Minimum="10" Maximum="100" Value="90" Width="160"
                Margin="10,0,6,0" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
        <TextBlock x:Name="QualityLabel" Text="90" Width="34" VerticalAlignment="Center" />

        <TextBlock x:Name="MaxSizeCaption" Margin="18,0,8,0" VerticalAlignment="Center" />
        <ComboBox x:Name="MaxSizeBox" SelectedIndex="0" Width="160" VerticalAlignment="Center">
          <ComboBoxItem x:Name="OriginalItem" />
          <ComboBoxItem Content="3840 px · 4K" />
          <ComboBoxItem Content="1920 px · 1080p" />
          <ComboBoxItem Content="1280 px · 720p" />
          <ComboBoxItem Content="1080 px" />
          <ComboBoxItem Content="512 px" />
        </ComboBox>

        <CheckBox x:Name="GrayscaleBox" Margin="18,0,0,0" VerticalAlignment="Center" />
      </WrapPanel>

      <!-- Drop zone -->
      <Panel DockPanel.Dock="Top" Height="190" Margin="0,18,0,0">
        <Rectangle x:Name="DropOutline" RadiusX="18" RadiusY="18" StrokeThickness="2"
                   StrokeDashArray="6,4" Stroke="#806C5CE7" Fill="#0E6C5CE7" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <TextBlock x:Name="DropTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="DropHint" Opacity="0.65" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
          <Button x:Name="OpenButton" HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>

      <!-- Footer -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Spacing="2">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        <TextBlock x:Name="EngineText" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Recent conversions -->
      <DockPanel Margin="0,18,0,0">
        <TextBlock x:Name="RecentCaption" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ScrollViewer>
          <ItemsControl x:Name="RecentList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="10" Background="#108A8F98">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxLines="3" />
                    </StackPanel>
                    <ProgressBar Grid.Column="1" Width="120" Minimum="0" Maximum="1" Margin="12,0"
                                 VerticalAlignment="Center"
                                 Value="{Binding Progress}" IsVisible="{Binding IsRunning}" />
                    <Button Grid.Column="2" Content="{Binding ShowLabel}" VerticalAlignment="Center"
                            Command="{Binding RevealCommand}" IsVisible="{Binding CanReveal}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </DockPanel>

    <!-- The ring floats above everything. The overlay only takes clicks while the ring is pinned. -->
    <Canvas x:Name="Overlay" Background="Transparent" IsHitTestVisible="False">
      <controls:DonutMenu x:Name="Donut" IsVisible="False" IsHitTestVisible="False" />
    </Canvas>
  </Grid>
</Window>
